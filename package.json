{
  "name": "doubao-cli",
  "version": "0.22.0",
  "description": "Doubao CLI with Linux/macOS headless HTTP and macOS desktop backends",
  "author": "Fullstop000 <fullstop1005@gmail.com>",
  "type": "module",
  "bin": {
    "doubao": "bin/doubao.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "docs/headless.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:headless": "node scripts/headless-e2e.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fullstop000/doubao-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Fullstop000/doubao-cli/issues"
  },
  "homepage": "https://github.com/Fullstop000/doubao-cli#readme",
  "keywords": [
    "doubao",
    "cli",
    "macos",
    "linux",
    "headless",
    "automation",
    "cdp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "13.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
